MQTT_URL=mqtt://localhost:1883

# Probability (0-1) that a given reading is generated outside its sensor's
# normal range, so threshold alerting has something to react to during a demo.
SIM_SPIKE_PROBABILITY=0.15

# Optional: override every sensor's publish interval (ms) with a single value.
# Leave unset to use each sensor's own interval (2000-5000ms, see src/sensors.ts).
# SIM_PUBLISH_INTERVAL_MS=3000
